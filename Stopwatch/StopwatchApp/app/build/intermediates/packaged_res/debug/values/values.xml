<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#F8F9FA</color>
    <color name="btn_disabled_color">#BDBDBD</color>
    <color name="btn_lap_color">#00ACC1</color>
    <color name="btn_pause_color">#FF9800</color>
    <color name="btn_reset_color">#F44336</color>
    <color name="btn_start_color">#4CAF50</color>
    <color name="divider_color">#E0E0E0</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_surface">#212121</color>
    <color name="on_surface_variant">#757575</color>
    <color name="primary">#1E88E5</color>
    <color name="primary_variant">#1565C0</color>
    <color name="secondary">#00ACC1</color>
    <color name="surface">#FFFFFF</color>
    <dimen name="button_height">52dp</dimen>
    <dimen name="card_corner_radius">20dp</dimen>
    <dimen name="card_elevation">4dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="text_size_lap_time">16sp</dimen>
    <dimen name="text_size_subtitle">14sp</dimen>
    <dimen name="text_size_timer">48sp</dimen>
    <dimen name="text_size_title">20sp</dimen>
    <string name="app_name">Stopwatch</string>
    <string name="btn_lap">Lap</string>
    <string name="btn_pause">Pause</string>
    <string name="btn_reset">Reset</string>
    <string name="btn_resume">Resume</string>
    <string name="btn_start">Start</string>
    <string name="default_time_display">00:00.00</string>
    <string name="empty_laps_message">No laps recorded yet. Press Start and tap Lap to record times.</string>
    <string name="lap_number_format">Lap %1$d</string>
    <string name="title_lap_history">Lap History</string>
    <string name="total_label_format">Total: %1$s</string>
    <style name="Theme.StopwatchApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/primary_variant</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="Widget.StopwatchApp.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Widget.StopwatchApp.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>